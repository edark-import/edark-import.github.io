rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
        )
      );
    }

    match /productos/{producto} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Órdenes/ventas solo mediante API server-side autenticada (evita manipulación de precios)
    match /ventas/{venta} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /cotizaciones/{cotizacion} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() &&
                    request.auth.uid == userId &&
                    !request.resource.data.keys().hasAny(['rol', 'role', 'admin', 'isAdmin']);
      allow update: if isAdmin() || (
                    isAuthenticated() &&
                    request.auth.uid == userId &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'role', 'admin', 'isAdmin'])
      );
      allow delete: if isAdmin();
    }

    // Solo lectura pública para config/public; cualquier config privada es admin-only
    match /config/public {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
